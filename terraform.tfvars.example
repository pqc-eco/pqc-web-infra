region                     = "us-east-1"
image_uri                  = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/pqc-web:1.0.0"
certificate_arn            = "arn:aws:acm:us-east-1:<account-id>:certificate/<id>"
jwt_private_key_secret_arn = "arn:aws:secretsmanager:us-east-1:<account-id>:secret:pqc-web/jwt-private-key"
data_key_secret_arn        = "arn:aws:secretsmanager:us-east-1:<account-id>:secret:pqc-web/data-key"
